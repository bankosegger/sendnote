# Redis credentials for note storage.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob store for encrypted image attachments. Auto-injected when a
# Blob store is connected to the project on Vercel; set manually for local dev.
BLOB_READ_WRITE_TOKEN=

# Optional: protects GET /api/cron/cleanup-images from being triggered by
# anyone but Vercel Cron. Set the same value in the Vercel project's env vars.
# CRON_SECRET=

BLOB_BASE_URL=
CRON_SECRET=

